# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
out/

# Claude — private instructions and per-machine session state.
# Project settings that SHOULD be shared live in .claude/settings.json, so that one is allow-listed
# back in; everything else under .claude/ (local permission overrides, run locks, usage state) is
# machine-local and was never meant to be committed.
CLAUDE.md
.claude/*
!.claude/settings.json

# Claude plugin / API keys
.env
.env.local
.env.*.local

# OS junk
.DS_Store
Thumbs.db

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Logs
logs/
*.log
